<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>


<!-- 根容器使用 StackPane 以便放置壁纸 -->
<StackPane fx:id="rootStackPane" styleClass="desktop-background"
           prefHeight="800.0" prefWidth="1200.0"
           xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.scau_os_simulation.controller.MainController">

    <stylesheets>
        <URL value="@style.css" />
        <URL value="@Desktop.css" /> <!-- 新增桌面样式 -->
    </stylesheets>


    <!-- 2. 桌面主体结构 -->
    <BorderPane pickOnBounds="false">
        <center>
            <!--
                将 AnchorPane 改为 FlowPane
                orientation="VERTICAL" 让图标先从上往下排，排满了一列再换列（类似 Windows 默认行为）
                styleClass="desktop-area" 在 CSS 里设置间距
            -->
            <FlowPane fx:id="desktopArea"
                      orientation="VERTICAL"
                      styleClass="desktop-area"
                      prefWrapLength="700"
                      onMouseClicked="#onDesktopClick">
                <!-- 图标将通过代码动态添加到这里 -->
            </FlowPane>
        </center>

        <!-- 底部：任务栏 -->
        <bottom>
            <HBox fx:id="taskBar" alignment="CENTER_LEFT" spacing="10" styleClass="task-bar">
                <Button fx:id="startMenuBtn" text="☁ Start" styleClass="start-button"/>
                <Separator orientation="VERTICAL" />
                <HBox fx:id="taskBarApps" spacing="5" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="tray-area">
                    <Label fx:id="systemClockLabel" text="12:00 PM" styleClass="clock-label"/>
                </HBox>
            </HBox>
        </bottom>
    </BorderPane>

    <!-- 3. 隐藏的视图资源池 (原 Tab 的内容移到这里) -->
    <!-- visible=false 确保初始不显示，代码会将它们移动到窗口中 -->
    <StackPane fx:id="hiddenViewPool" visible="false" managed="false">

        <!-- 进程管理视图 -->
        <VBox fx:id="processViewRoot" spacing="15" styleClass="window-content">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10;" styleClass="card">
                <Button fx:id="createProcessBtn" onAction="#onCreateProcessClick" styleClass="button, accent" text="➕ 新建进程" />
                <Button fx:id="terminateProcessBtn" onAction="#onTerminateProcessClick" styleClass="button, danger" text="❌ 结束任务" />
                <Separator orientation="VERTICAL" />
                <Button fx:id="startSystemBtn" onAction="#onStartSystemClick" styleClass="button, success" text="▶ 启动调度" />
                <Button fx:id="stopSystemBtn" onAction="#onStopSystemClick" styleClass="button, flat" text="⏸ 暂停" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
            <SplitPane dividerPositions="0.75" style="-fx-background-color:transparent;" VBox.vgrow="ALWAYS">
                <VBox styleClass="card" VBox.vgrow="ALWAYS">
                    <TableView fx:id="processTableView" styleClass="table-view, dense, striped" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="pidColumn" prefWidth="60" text="PID" />
                            <TableColumn fx:id="nameColumn" prefWidth="140" text="进程名称" />
                            <TableColumn fx:id="stateColumn" prefWidth="90" text="状态" />
                            <TableColumn fx:id="priorityColumn" prefWidth="70" text="优先级" />
                            <TableColumn fx:id="memoryAddressColumn" prefWidth="90" text="内存基址" />
                            <TableColumn fx:id="memorySizeColumn" prefWidth="90" text="占用内存" />
                            <TableColumn fx:id="timeSliceColumn" prefWidth="90" text="剩余时间片" />
                            <TableColumn fx:id="totalRemainingTimeColumn" prefWidth="100" text="总剩余时间" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
                <ScrollPane fitToWidth="true" styleClass="card">
                    <VBox spacing="20">
                        <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                        <VBox spacing="10">
                            <Label styleClass="title-4" text="CPU 实时状态" />
                            <GridPane hgap="10" vgap="8">
                                <Label styleClass="text-caption" text="运行进程" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="runningPidLabel" styleClass="accent" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label styleClass="text-caption" text="指令(IR)" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="irLabel" styleClass="text-monospace" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label styleClass="text-caption" text="寄存器(AX)" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <Label fx:id="axLabel" styleClass="text-monospace" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label styleClass="text-caption" text="剩余时间片" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <Label fx:id="tsLabel" styleClass="text-bold" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <columnConstraints><ColumnConstraints /><ColumnConstraints /></columnConstraints>
                                <rowConstraints><RowConstraints /><RowConstraints /><RowConstraints /><RowConstraints /><RowConstraints /></rowConstraints>
                            </GridPane>
                        </VBox>
                        <Separator />
                        <VBox spacing="10">
                            <Label styleClass="title-4" text="就绪队列 (Ready)" />
                            <ListView fx:id="readyQueueListView" prefHeight="100" styleClass="list-view, dense" />
                        </VBox>
                        <VBox spacing="10">
                            <Label styleClass="title-4" text="阻塞队列 (Blocked)" />
                            <ListView fx:id="blockedQueueListView" prefHeight="100" styleClass="list-view, dense" />
                        </VBox>
                        <Separator />
                        <VBox spacing="10">
                            <Label styleClass="title-4" text="内核日志" />
                            <ListView fx:id="operationLogListView" prefHeight="150" styleClass="list-view, dense" />
                        </VBox>
                        <VBox spacing="10">
                            <Label styleClass="title-4" text="程序控制台输出" />
                            <ListView fx:id="outputListView" prefHeight="100" styleClass="list-view, dense, text-monospace" />
                        </VBox>
                    </VBox>
                </ScrollPane>
            </SplitPane>
        </VBox>



        <VBox fx:id="memoryViewRoot" spacing="15" styleClass="window-content">
            <HBox alignment="CENTER_LEFT" prefHeight="100" spacing="20" styleClass="card">
                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                <Button fx:id="defragmentBtn" onAction="#onDefragmentClick" styleClass="button, accent" text="🧹 内存碎片整理" />

                <Separator orientation="VERTICAL" />

                <VBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                    <BorderPane>
                        <left><Label styleClass="text-caption" text="内存使用率" /></left>
                        <right><Label fx:id="memoryInfoLabel" styleClass="text-bold" text="0 KB / 1024 KB" /></right>
                    </BorderPane>
                    <ProgressBar fx:id="memoryUsageBar" maxWidth="Infinity" progress="0.0" />
                </VBox>

                <Separator orientation="VERTICAL" />

                <HBox alignment="CENTER" spacing="5">
                    <Label fx:id="fragmentationLabel" styleClass="title-4, warning" text="0%" />
                </HBox>
            </HBox>

            <VBox styleClass="card" spacing="10">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <Label text="内存空间分布图 (可视化碎片)" styleClass="title-4"/>

                <VBox spacing="0">
                    <Pane fx:id="memoryVisualizationPane" prefHeight="50" minHeight="50" maxHeight="50"
                          style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 3 3 0 0; -fx-border-width: 1 1 0 1;">
                    </Pane>
                    <Pane fx:id="memoryRulerPane" prefHeight="30" minHeight="30" maxHeight="30"
                          style="-fx-border-color: #bdc3c7; -fx-border-radius: 0 0 3 3; -fx-border-width: 0 1 1 1; -fx-background-color: #fcfcfc"/>
                </VBox>

                <FlowPane hgap="20" vgap="10">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Region prefWidth="12" prefHeight="12" style="-fx-background-color: #e74c3c; -fx-border-color: #c0392b; -fx-border-radius: 2;"/>
                        <Label text="系统预留" styleClass="text-caption"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Region prefWidth="12" prefHeight="12" style="-fx-background-color: #3498db; -fx-border-color: #2980b9; -fx-border-radius: 2;"/>
                        <Label text="用户进程" styleClass="text-caption"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Region prefWidth="12" prefHeight="12" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 2;"/>
                        <Label text="空闲碎片" styleClass="text-caption"/>
                    </HBox>
                </FlowPane>
            </VBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <Label styleClass="title-4" text="物理内存分配表">
                    <padding><Insets bottom="10" left="15" top="10"/></padding>
                </Label>
                <TableView fx:id="memoryBlockTableView" styleClass="table-view, dense, striped" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="startAddressColumn" prefWidth="150" text="起始地址 (Hex)" />
                        <TableColumn fx:id="blockSizeColumn" prefWidth="150" text="块大小 (KB)" />
                        <TableColumn fx:id="processColumn" prefWidth="200" text="归属进程" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>



        <!-- 文件系统视图 -->
        <VBox fx:id="fileSystemViewRoot" spacing="15" styleClass="window-content">
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10;" styleClass="card">
                <Button fx:id="createFileBtn" onAction="#onCreateFileClick" styleClass="button, flat" text="📄 新建文件" />
                <Button fx:id="createDirectoryBtn" onAction="#onCreateDirectoryClick" styleClass="button, flat" text="📁 新建目录" />
                <Separator orientation="VERTICAL" />
                <Button fx:id="copyFileBtn" onAction="#onCopyFileClick" styleClass="button, flat" text="📋 复制" />
                <Button fx:id="pasteFileBtn" onAction="#onPasteFileClick" styleClass="button, flat" text="📌 粘贴" />
                <Separator orientation="VERTICAL" />
                <Button fx:id="deleteFileBtn" onAction="#onDeleteClick" styleClass="button, danger" text="🗑 删除" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="searchFileBtn" onAction="#onSearchFileClick" styleClass="button, accent" text="🔍 搜索" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15 25;" styleClass="card">
                <Label style="-fx-font-size: 28px;" text="💾" />
                <VBox alignment="CENTER_LEFT" prefWidth="120" spacing="2">
                    <Label styleClass="title-4" text="本地磁盘 (C:)" />
                    <Label styleClass="text-caption" text="系统卷" />
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
                    <BorderPane>
                        <left><Label styleClass="text-caption" text="磁盘使用情况" /></left>
                        <right><Label fx:id="diskInfoLabel" styleClass="text-bold" text="计算中..." /></right>
                    </BorderPane>
                    <ProgressBar fx:id="diskUsageBar" maxWidth="Infinity" progress="0.0" />
                </VBox>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <Label styleClass="title-4" text="资源管理器"><padding><Insets bottom="10" left="10" top="10"/></padding></Label>
                <TreeView fx:id="fileSystemTreeView" showRoot="true" styleClass="dense" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>

        <!-- 设备管理视图 -->
        <AnchorPane fx:id="deviceViewRoot" styleClass="window-content">
            <SplitPane dividerPositions="0.5" orientation="VERTICAL" style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                <VBox styleClass="card">
                    <Label styleClass="title-4" text="设备实时状态"><padding><Insets bottom="5" left="15" top="10" /></padding></Label>
                    <TableView fx:id="deviceTableView" styleClass="table-view, dense, striped" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="deviceTypeColumn" text="设备类型" />
                            <TableColumn fx:id="deviceInUseColumn" text="是否忙碌" />
                            <TableColumn fx:id="devicePidColumn" text="占用 PID" />
                            <TableColumn fx:id="deviceRemainColumn" text="剩余时间" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>
                <VBox styleClass="card">
                    <Label styleClass="title-4" text="设备等待队列"><padding><Insets bottom="5" left="15" top="10" /></padding></Label>
                    <TableView fx:id="waitQueueTableView" styleClass="table-view, dense, striped" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="waitDeviceColumn" text="目标设备" />
                            <TableColumn fx:id="waitPidColumn" text="等待进程 PID" />
                            <TableColumn fx:id="waitTimeColumn" text="预计时长" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>
            </SplitPane>
        </AnchorPane>

        <!-- 性能监视器视图 -->
        <VBox fx:id="performanceViewRoot" spacing="15" styleClass="window-content">
            <GridPane hgap="15" vgap="15">
                <columnConstraints><ColumnConstraints percentWidth="50" /><ColumnConstraints percentWidth="50" /></columnConstraints>
                <VBox spacing="10" styleClass="card" GridPane.columnIndex="0">
                    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="title-4" text="CPU 利用率" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="cpuUtilizationLabel" styleClass="title-3, accent" text="0%" />
                    </HBox>
                    <ProgressBar fx:id="cpuUtilizationBar" maxWidth="Infinity" />
                    <HBox spacing="15">
                        <Label fx:id="avgCpuLabel" styleClass="text-caption" text="平均: 0%" />
                        <Label fx:id="peakCpuLabel" styleClass="text-caption" text="峰值: 0%" />
                    </HBox>
                </VBox>
                <VBox spacing="10" styleClass="card" GridPane.columnIndex="1">
                    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="title-4" text="系统负载" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="systemLoadLabel" styleClass="title-3, warning" text="0.0" />
                    </HBox>
                    <ProgressBar fx:id="systemLoadBar" maxWidth="Infinity" />
                    <HBox spacing="15">
                        <Label fx:id="avgMemoryLabel" styleClass="text-caption" text="平均: 0%" />
                        <Label fx:id="peakMemoryLabel" styleClass="text-caption" text="峰值: 0%" />
                    </HBox>
                </VBox>
                <rowConstraints><RowConstraints /></rowConstraints>
            </GridPane>
            <StackPane fx:id="performanceChartContainer" styleClass="card" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
            </StackPane>
        </VBox>

    </StackPane>

</StackPane>