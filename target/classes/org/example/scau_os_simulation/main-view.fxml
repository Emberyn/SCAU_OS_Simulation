<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<!--
  美化后的主界面布局：
  - 现代化的配色方案和更大的间距
  - 选项卡采用两端对齐布局
  - 组件间距更宽松，视觉效果更舒适
  - 按钮采用圆角设计和悬停效果
  - 整体采用卡片式设计风格
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.scau_os_simulation.controller.MainController"
            prefHeight="700.0" prefWidth="900.0">

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>

    <top>
        <!-- 使用 VBox 垂直排列：上面是菜单栏，下面是工具栏 -->
        <VBox>

            <!-- 1. 顶部菜单栏 (保留原有的) -->
            <MenuBar styleClass="menu-bar">
                <Menu text="文件">
                    <MenuItem text="退出" onAction="#onExitAction"/>
                </Menu>
                <Menu text="帮助">
                    <MenuItem text="关于" onAction="#onAboutAction"/>
                </Menu>
            </MenuBar>

            <ToolBar style="-fx-background-color: white; -fx-padding: 10px; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <items>
                    <!-- 左侧：显示系统状态 -->
                    <Label fx:id="systemStatusLabel" text="状态: 等待启动"
                           style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 0 5;"/>

                    <!-- 中间占位符 -->
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- 右侧：启动按钮 (样式已移至 CSS 的 #startSystemBtn) -->
                    <Button fx:id="startSystemBtn"
                            text="▶ 启动系统"
                            onAction="#onStartSystemClick" />
                </items>
            </ToolBar>
        </VBox>
    </top>
    
    <center>
        <!-- 中央区域：主要功能选项卡 - 采用两端对齐 -->
        <TabPane fx:id="tabPane" styleClass="tab-pane"
                 tabMinWidth="120"
                 tabMaxWidth="200">
            
            <Tab fx:id="processTab" text="进程管理" closable="false" styleClass="tab">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                    <VBox fx:id="processContainer" spacing="20" styleClass="card">
                        <padding>
                            <Insets top="25" right="25" bottom="25" left="25"/>
                        </padding>
                        
                        <!-- 操作按钮区域 -->
                        <HBox spacing="15">
                            <Button fx:id="createProcessBtn" text="创建进程" 
                                    onAction="#onCreateProcessClick"/>
                            <Button fx:id="terminateProcessBtn" text="终止进程" 
                                    onAction="#onTerminateProcessClick"/>
                            <Button fx:id="undoBtn" text="撤销" 
                                    onAction="#onUndoClick"/>
                            <Button fx:id="redoBtn" text="重做" 
                                    onAction="#onRedoClick"/>
                        </HBox>
                        
                        <!-- 状态信息区域 -->
                        <HBox spacing="20" styleClass="status-panel">
                            <Label text="系统时钟:" styleClass="status-label"/>
                            <Label fx:id="systemClockLabel" text="0" styleClass="status-value status-clock"/>
                            <Separator orientation="VERTICAL"/>
                            <Label text="运行进程PID:" styleClass="status-label"/>
                            <Label fx:id="runningPidLabel" text="-" styleClass="status-value status-pid"/>
                            <Separator orientation="VERTICAL"/>
                            <Label text="指令:" styleClass="status-label"/>
                            <Label fx:id="irLabel" text="-" styleClass="status-value status-instruction"/>
                            <Separator orientation="VERTICAL"/>
                            <Label text="AX:" styleClass="status-label"/>
                            <Label fx:id="axLabel" text="0" styleClass="status-value status-ax"/>
                            <Separator orientation="VERTICAL"/>
                            <Label text="时间片:" styleClass="status-label"/>
                            <Label fx:id="tsLabel" text="6" styleClass="status-value status-timeslice"/>
                        </HBox>
                        
                        <!-- 进程表格 -->
                        <VBox spacing="10">
                            <Label text="进程列表" styleClass="title"/>
                            <TableView fx:id="processTableView" styleClass="data-table"
                                       prefHeight="200">
                                <columns>
                                    <TableColumn text="PID" fx:id="pidColumn" prefWidth="60"/>
                                    <TableColumn text="名称" fx:id="nameColumn" prefWidth="120"/>
                                    <TableColumn text="状态" fx:id="stateColumn" prefWidth="100"/>
                                    <TableColumn text="优先级" fx:id="priorityColumn" prefWidth="80"/>
                                    <TableColumn text="内存地址" fx:id="memoryAddressColumn" prefWidth="100"/>
                                    <TableColumn text="内存大小" fx:id="memorySizeColumn" prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                        
                        <!-- 队列信息 -->
                        <HBox spacing="20">
                            <VBox spacing="10" styleClass="queue-panel">
                                <Label text="就绪队列" styleClass="queue-ready"/>
                                <ListView fx:id="readyQueueListView" prefHeight="120" styleClass="queue-list"/>
                            </VBox>
                            <VBox spacing="10" styleClass="queue-panel">
                                <Label text="阻塞队列" styleClass="queue-blocked"/>
                                <ListView fx:id="blockedQueueListView" prefHeight="120" styleClass="queue-list"/>
                            </VBox>
                        </HBox>
                        
                        <!-- 执行结果 -->
                        <VBox spacing="10">
                            <Label text="执行结果" styleClass="title"/>
                            <ListView fx:id="outputListView" prefHeight="100" styleClass="output-list"/>
                        </VBox>
                        
                        <!-- 操作日志 -->
                        <VBox spacing="10">
                            <Label text="操作日志" styleClass="title"/>
                            <ListView fx:id="operationLogListView" prefHeight="150" styleClass="log-list"/>
                        </VBox>
                        
                        <!-- 性能监控 -->
                        <VBox spacing="10">
                            <Label text="性能监控" styleClass="title"/>
                            <HBox spacing="15">
                                <VBox spacing="5">
                                    <Label text="CPU利用率" styleClass="performance-label"/>
                                    <ProgressBar fx:id="cpuUtilizationBar" progress="0.0" 
                                               prefWidth="200" styleClass="cpu-progress"/>
                                    <Label fx:id="cpuUtilizationLabel" text="0.0%" 
                                           styleClass="performance-value"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="系统负载" styleClass="performance-label"/>
                                    <ProgressBar fx:id="systemLoadBar" progress="0.0" 
                                               prefWidth="200" styleClass="load-progress"/>
                                    <Label fx:id="systemLoadLabel" text="0.0%" 
                                           styleClass="performance-value"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="15">
                                <VBox spacing="5">
                                    <Label text="平均CPU利用率" styleClass="performance-label"/>
                                    <Label fx:id="avgCpuLabel" text="0.0%" styleClass="performance-value"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="平均内存使用率" styleClass="performance-label"/>
                                    <Label fx:id="avgMemoryLabel" text="0.0%" styleClass="performance-value"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="峰值CPU利用率" styleClass="performance-label"/>
                                    <Label fx:id="peakCpuLabel" text="0.0%" styleClass="performance-value"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="峰值内存使用率" styleClass="performance-label"/>
                                    <Label fx:id="peakMemoryLabel" text="0.0%" styleClass="performance-value"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
            
            <Tab fx:id="memoryTab" text="内存管理" closable="false" styleClass="tab">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                    <VBox spacing="20" styleClass="card">
                        <padding>
                            <Insets top="25" right="25" bottom="25" left="25"/>
                        </padding>
                        
                        <VBox spacing="15">
                            <Label text="内存使用情况" styleClass="memory-usage"/>
                            <ProgressBar fx:id="memoryUsageBar" progress="0.0" 
                                         prefWidth="600" styleClass="memory-progress"/>
                            <Label fx:id="memoryInfoLabel" text="已使用: 0KB / 总计: 0KB" 
                                   styleClass="memory-info"/>
                            <Label fx:id="fragmentationLabel" text="碎片率: 0% | 最大连续空闲: 0KB" 
                                   styleClass="memory-fragmentation"/>
                            <HBox spacing="15">
                                <Button fx:id="defragmentBtn" text="内存整理" 
                                        onAction="#onDefragmentClick"/>
                            </HBox>
                        </VBox>
                        
                        <VBox spacing="10">
                            <Label text="内存块分配" styleClass="memory-blocks"/>
                            <TableView fx:id="memoryBlockTableView" 
                                       styleClass="data-table"
                                       prefHeight="300">
                                <columns>
                                    <TableColumn text="起始地址" fx:id="startAddressColumn" prefWidth="150"/>
                                    <TableColumn text="大小" fx:id="blockSizeColumn" prefWidth="100"/>
                                    <TableColumn text="进程" fx:id="processColumn" prefWidth="200"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
            
            <Tab fx:id="fileSystemTab" text="文件系统" closable="false" styleClass="tab">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                    <VBox spacing="20" styleClass="card">
                        <padding>
                            <Insets top="25" right="25" bottom="25" left="25"/>
                        </padding>
                        
                        <!-- 操作按钮 -->
                        <HBox spacing="15">
                            <Button fx:id="createFileBtn" text="创建文件" 
                                    onAction="#onCreateFileClick"/>
                            <Button fx:id="createDirectoryBtn" text="创建目录" 
                                    onAction="#onCreateDirectoryClick"/>
                            <Button fx:id="deleteFileBtn" text="删除" 
                                    onAction="#onDeleteClick"/>
                        </HBox>
                        
                        <!-- 磁盘使用情况 -->
                        <VBox spacing="10" styleClass="queue-panel">
                            <Label text="磁盘使用情况" styleClass="disk-usage"/>
                            <ProgressBar fx:id="diskUsageBar" progress="0.0" 
                                         prefWidth="600" styleClass="disk-progress"/>
                            <Label fx:id="diskInfoLabel" text="已使用: 0KB / 总计: 0KB" 
                                   styleClass="disk-info"/>
                        </VBox>
                        
                        <!-- 文件树 -->
                        <VBox spacing="10">
                            <Label text="文件系统树" styleClass="title"/>
                            <TreeView fx:id="fileSystemTreeView" 
                                      styleClass="data-table"
                                      prefHeight="400"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
            
            <Tab text="设备管理" closable="false" styleClass="tab">
                <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                    <VBox spacing="20" styleClass="card">
                        <padding>
                            <Insets top="25" right="25" bottom="25" left="25"/>
                        </padding>
                        
                        <!-- 设备使用状态 -->
                        <VBox spacing="15">
                            <Label text="设备使用状态" styleClass="title"/>
                            <TableView fx:id="deviceTableView" 
                                       styleClass="data-table"
                                       prefHeight="200">
                                <columns>
                                    <TableColumn text="类型" fx:id="deviceTypeColumn" prefWidth="120"/>
                                    <TableColumn text="使用中" fx:id="deviceInUseColumn" prefWidth="100"/>
                                    <TableColumn text="进程PID" fx:id="devicePidColumn" prefWidth="100"/>
                                    <TableColumn text="剩余时间" fx:id="deviceRemainColumn" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                        
                        <!-- 设备等待队列 -->
                        <VBox spacing="15">
                            <Label text="设备使用状态" styleClass="device-status"/>
                            <TableView fx:id="waitQueueTableView" 
                                       styleClass="data-table"
                                       prefHeight="200">
                                <columns>
                                    <TableColumn text="设备" fx:id="waitDeviceColumn" prefWidth="150"/>
                                    <TableColumn text="进程PID" fx:id="waitPidColumn" prefWidth="120"/>
                                    <TableColumn text="请求时间" fx:id="waitTimeColumn" prefWidth="150"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>
    </center>
    
    <bottom>
        <!-- 底部状态栏与命令输入 - 采用现代化设计 -->
        <HBox alignment="CENTER_LEFT" spacing="15" 
              styleClass="status-bar">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="状态: 系统运行中" styleClass="status-text"/>
            <Region prefWidth="20"/>
            <TextField fx:id="commandField" 
                       promptText="输入命令，如: $mkdir /user/docs 或 $create /user/new.txt" 
                       prefWidth="500"
                       styleClass="command-field"/>
            <Button fx:id="runCommandBtn" text="执行" 
                    onAction="#onRunCommandClick"/>
        </HBox>
    </bottom>
</BorderPane>
